DATABASE_URI=postgres://postgres:postgres@localhost:5432/notionforge

PAYLOAD_SECRET=change-me-to-a-long-random-string

# Better Auth (end-user login/signup for app routes).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sandbox orchestrator (all optional, sane defaults shown).
SANDBOX_WORKSPACE_ROOT=.sandbox-workspaces
SANDBOX_IMAGE=node:20-alpine
SANDBOX_CONTAINER_USER=node
SANDBOX_MEMORY_BYTES=536870912
SANDBOX_CPU=1
SANDBOX_PIDS_LIMIT=256
SANDBOX_STOP_TIMEOUT=10
SANDBOX_IDLE_TIMEOUT_MINUTES=15
SANDBOX_RUNTIME=auto
SANDBOX_NETWORK=none
SANDBOX_INTERNAL_NETWORK=notionforge-sandbox
