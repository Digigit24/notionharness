
DATABASE_URI=postgres://postgres:postgres@localhost:5432/notionforge

PAYLOAD_SECRET=change-me-to-a-long-random-string

# Better Auth (end-user login/signup for app/(app)/* routes — separate from
# Payload's own /admin auth). Generate with `npx better-auth secret`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Self-hosted Teable instance (see docker-compose stack in ../teable-selfhost).
# Use host.docker.internal, not localhost — this app runs inside a container
# (notionforge-app), and localhost there means the container itself, not the
# host machine where Teable's port is published. If notionforge-app ever runs
# directly on the host (not in Docker), switch this back to localhost.
TEABLE_API_URL=http://host.docker.internal:3100/api
TEABLE_API_KEY=
TEABLE_BASE_ID=
# Separate, broader-scoped token (space|read, base|create, table|create, etc.)
# used ONLY by the "create new Teable table" flow — regular record/field CRUD
# stays on the narrower TEABLE_API_KEY above (defense in depth).
TEABLE_API_KEY_CREATOR=

# Sandbox orchestrator (lib/sandbox) — all optional, sane defaults shown.
# Host directory under which each workspace's files live as <root>/<workspaceId>.
SANDBOX_WORKSPACE_ROOT=.sandbox-workspaces
# Container image + non-root user for sandbox sessions (user must exist in image).
SANDBOX_IMAGE=node:20-alpine
SANDBOX_CONTAINER_USER=node
# Resource caps: memory (bytes), CPU (cores), max processes, stop timeout (s).
SANDBOX_MEMORY_BYTES=536870912
SANDBOX_CPU=1
SANDBOX_PIDS_LIMIT=256
SANDBOX_STOP_TIMEOUT=10
# Auto-destroy idle sessions after this many minutes (default 15).
SANDBOX_IDLE_TIMEOUT_MINUTES=15
# Container runtime: runsc (gVisor, if installed) | runc | auto.
SANDBOX_RUNTIME=auto
# Egress posture: none (default, no network) | internal (isolated bridge, no internet).
SANDBOX_NETWORK=none
SANDBOX_INTERNAL_NETWORK=notionforge-sandbox
