DATABASE_URI=postgres://postgres:postgres@localhost:5432/notionforge

PAYLOAD_SECRET=change-me-to-a-long-random-string

# Better Auth (end-user login/signup for app routes).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Hermes (lib/hermes-api.ts, lib/hermes/home-overlay.ts). No default —
# Phase C's C1.0 removed the hardcoded personal values these used to fall
# back to (a specific developer's Tailscale hostname and Windows home path),
# since baking either into source meant nobody else could point this app at
# their own Hermes install without editing checked-in code.
HERMES_API_BASE_URL=
HERMES_API_KEY=
# The real Hermes install directory on this machine, e.g.
# "C:\Users\<you>\AppData\Local\hermes" on Windows.
HERMES_HOME_BASE=
# Path to the hermes-acp binary — only needed by scripts/*.ts dev harnesses
# (hermes-acp-smoke, test-run-usage, test-dispatcher-core, seed-starter-
# workspace), not the app itself. Those scripts derive this from
# HERMES_HOME_BASE + "hermes-agent/venv/Scripts/hermes-acp.exe" by default
# (Windows venv layout) — set this only if that derived path is wrong for
# your Hermes install.
HERMES_ACP_BIN=

# Web Push (ROADMAP B5.3 — Batch B-5 "Attention"). These are real
# cryptographic keys, not placeholders to fill in casually — generate a real
# pair once `web-push` is installed (`npx web-push generate-vapid-keys`) and
# set both. Until both are set, lib/push/send.ts's sendPushToUser() no-ops
# (logs a warning) rather than sending or throwing.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@notionforge.local

# Shared secret for the two internal routes an external loop polls:
# POST /api/dispatcher/tick (claims a queued run and spawns a real agent
# process on this host) and POST /api/runtimes/health-check. Sent by
# scripts/run-dispatcher-loop.ts and scripts/run-runtime-health-loop.ts as
# the X-Dispatcher-Secret header; a workspace owner/admin's browser session
# is accepted instead, which is what the runtimes page's Refresh button uses.
#
# REQUIRED IN PRODUCTION. A production build refuses both routes with a 503
# naming this variable until it is set, because unset previously meant
# 'anyone who can resolve the hostname may run agents here'. A development
# build still allows them unset (with a warning), so an existing local setup
# keeps working unchanged. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DISPATCHER_SECRET=
